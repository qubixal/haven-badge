		(rev "A")
		(company "qubixal")
		(comment 1 "Edge.Cuts = union of flower + paws from badge.svg")
		(comment 2 "Scale: panel outline width 71.82mm = 389 svg units")
		(comment 3 "F.Cu parts sit under the GDEY0266T90 panel")
		(comment 4 "Colours: white mask + PCBWay UV Multi-color artwork")
	)
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
